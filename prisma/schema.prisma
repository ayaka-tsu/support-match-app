generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                  String    @id @db.Uuid
  nickname            String
  support_available   Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  latitude            Float?
  longitude           Float?
  location_updated_at DateTime? @db.Timestamptz(6)
  avatar_url          String?

  @@map("profiles")
}

model Store {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String?
  sort_order       BigInt           @unique @default(autoincrement())
  support_requests SupportRequest[]

  @@map("stores")
}

model SupportRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  store_id            String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  latitude            Float?
  longitude           Float?
  location_updated_at DateTime? @db.Timestamptz(6)
  expired_seen_at     DateTime? @db.Timestamptz(6)
  matching            Matching?
  store               Store     @relation(fields: [store_id], references: [id])

  @@map("support_requests")
}

model Matching {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  support_request_id String         @unique @db.Uuid
  supporter_id       String         @db.Uuid
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @updatedAt @db.Timestamptz(6)
  status             String         @default("active")
  ended_at           DateTime?      @db.Timestamptz(6)
  canceled_by        String?        @db.Uuid
  canceled_seen_at   DateTime?      @db.Timestamptz(6)
  supporter_seen_at  DateTime?      @db.Timestamptz(6)
  requester_seen_at  DateTime?      @db.Timestamptz(6)
  ended_by           String?        @db.Uuid
  ended_seen_at      DateTime?      @db.Timestamptz(6)
  support_request    SupportRequest @relation(fields: [support_request_id], references: [id])
  messages           Message[]

  @@map("matchings")
}

model Message {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String    @db.Uuid
  matching_id String    @db.Uuid
  content     String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  read_at     DateTime? @db.Timestamptz(6)
  matching    Matching  @relation(fields: [matching_id], references: [id])

  @@map("messages")
}
