generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String   @id @db.Uuid
  nickname          String
  support_available Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("profiles")
}

model Store {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  address          String?
  support_requests SupportRequest[]

  @@map("stores")
}

model SupportRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  store_id   String    @db.Uuid
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  matching   Matching?
  store      Store     @relation(fields: [store_id], references: [id])

  @@map("support_requests")
}

model Matching {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  support_request_id String         @unique @db.Uuid
  supporter_id       String         @db.Uuid
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  support_request    SupportRequest @relation(fields: [support_request_id], references: [id])
  messages           Message[]

  @@map("matchings")
}

model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String   @db.Uuid
  matching_id String   @db.Uuid
  content     String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  matching    Matching @relation(fields: [matching_id], references: [id])

  @@map("messages")
}
